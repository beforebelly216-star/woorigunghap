# Browser-safe PortOne values. Copy this file to .env.local and fill in your values.
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ and never commit .env.local.
PORTONE_API_SECRET=portone_v2_api_secret
PORTONE_WEBHOOK_SECRET=portone_webhook_secret

# AI 리포트 생성은 서버에서만 실행합니다. 이 값은 절대 NEXT_PUBLIC_로 시작하지 않습니다.
# 처음에는 template으로 두고, OpenAI API Key를 넣은 뒤 openai로 변경합니다.
REPORT_NARRATIVE_MODE=template
OPENAI_API_KEY=
OPENAI_MODEL=

# The public base URL used for redirect and webhook registration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
