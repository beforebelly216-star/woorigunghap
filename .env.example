# Browser-safe PortOne values. Copy this file to .env.local and fill in your values.
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Server-only payment secrets. Never prefix these with NEXT_PUBLIC_ and never commit .env.local.
PORTONE_API_SECRET=portone_v2_api_secret
PORTONE_WEBHOOK_SECRET=portone_webhook_secret

# Optional Day 5 verification oracle. Use the decoded service key issued by data.go.kr.
# Production report generation must not depend on this API being available.
KASI_SERVICE_KEY=

# Paid narrative generation runs only on the server.
# Do not prefix any Anthropic secret with NEXT_PUBLIC_.
REPORT_NARRATIVE_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_NARRATIVE_MODEL=claude-haiku-4-5-20251001

# Day 11 server-side order/report storage (Vercel Marketplace Neon Postgres).
# Keep this server-only. Cross-device resumable reports require DATABASE_URL.
DATABASE_URL=

# Kakao login. KAKAO_ADMIN_KEY is used server-side only to unlink a Kakao account
# when the user completes account deletion. Never expose these with NEXT_PUBLIC_.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
KAKAO_ADMIN_KEY=
# 32 random bytes encoded as 64 hex characters. Used to encrypt sensitive Kakao
# notification data at rest. After adding or rotating this value in Vercel, redeploy.
KAKAO_TOKEN_ENCRYPTION_KEY=

# KakaoTalk Channel Alimtalk delivery through SOLAPI.
# Link an approved Kakao Business channel and an approved informational Alimtalk template.
# The template should contain the static completion message and a button to /account/reports.
# SMS fallback is disabled in code, so no sender phone number is required for this flow.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_KAKAO_PF_ID=
SOLAPI_KAKAO_TEMPLATE_ID=

# Public operator information shown in the footer and policies.
# Complete all of these before real-money public launch.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_EMAIL=
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
NEXT_PUBLIC_ECOMMERCE_REGISTRATION_NUMBER=

# Cost log conversion assumption only. Change when the internal accounting FX assumption changes.
AI_COST_USD_KRW=1450

# The public base URL used for redirects and public links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
