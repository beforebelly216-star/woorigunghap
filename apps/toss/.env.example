# Public server origin only. Never place provider credentials or PEM values in VITE_ variables.
VITE_API_BASE_URL=
# Ads default OFF until service content and native QA are ready. IDs are public group IDs, not API secrets.
VITE_ADS_ENABLED=false
# Keep true for console/QR testing; use production IDs only in the launch bundle.
VITE_ADS_TEST_MODE=true
VITE_TOSS_BANNER_AD_GROUP_ID=ait.v2.live.732b6817f34e4c8f
# Both fullscreen groups are interstitials. Secondary group is reserved for a future placement:
# ait.v2.live.2ba69cd75b514ab9. No rewarded group has been provided.
VITE_TOSS_REWARDED_AD_GROUP_ID=
VITE_TOSS_INTERSTITIAL_AD_GROUP_ID=ait.v2.live.6389f70518ed4f97
# Fullscreen test IDs must be verified official IDs for the matching ad format.
VITE_TOSS_TEST_REWARDED_AD_GROUP_ID=
VITE_TOSS_TEST_INTERSTITIAL_AD_GROUP_ID=
